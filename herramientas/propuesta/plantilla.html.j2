{% set c = d.cliente %}
{% set p = d.precios %}
{% set TOTAL_SLIDES = 13 %}
{% set n = namespace(i=0) %}
{% macro kicker(titulo) %}
{% set n.i = n.i + 1 %}
<div class="kicker"><span class="idx">{{ '%02d'|format(n.i) }}</span><span>{{ titulo }}</span></div>
{% endmacro %}
{% macro chevrons(prev, next) %}
<div class="chev">
  {% if prev %}<a href="#{{ prev }}" class="chev-btn" aria-label="Anterior">‹</a>{% else %}<span class="chev-btn ghost">‹</span>{% endif %}
  <span class="counter" data-counter>01 / {{ TOTAL_SLIDES }}</span>
  {% if next %}<a href="#{{ next }}" class="chev-btn" aria-label="Siguiente">›</a>{% else %}<span class="chev-btn ghost">›</span>{% endif %}
</div>
{% endmacro %}
{% macro implementacion() %}
<h3 class="h3">{% if p.mostrar_piloto %}Opción 2 · {% endif %}Implementación completa <span class="tag">-{{ p.descuento_pct }} %</span></h3>
<div class="tabgroup" style="margin-top:4px">
  <input type="radio" name="cond" id="cond-base" class="tab-radio" checked>
  <label for="cond-base" class="tab-btn sm">Precio final</label>
  {% for f in p.extras %}
  <input type="radio" name="cond" id="cond-extra{{ loop.index }}" class="tab-radio">
  <label for="cond-extra{{ loop.index }}" class="tab-btn sm">{{ f.nombre }}</label>
  {% endfor %}

  <div class="tab-panel" id="cond-panel-base">
    <div class="stats">
      <div class="stat"><b data-fmt="eur2" data-value="{{ p.oferta.precio }}">{{ p.oferta.precio|eur(2) }}</b><span>€/emp/mes</span></div>
      <div class="stat"><b data-fmt="eur2" data-value="{{ p.oferta.mensual }}">{{ p.oferta.mensual|eur(2) }}</b><span>Total mensual</span></div>
      <div class="stat"><b data-fmt="eur0" data-value="{{ p.oferta.anio1 }}">{{ p.oferta.anio1|eur }}</b><span>Total año 1</span></div>
      <div class="stat hi"><b data-fmt="pct" data-value="{{ p.oferta.ahorro_pct }}">-{{ p.oferta.ahorro_pct }} %</b><span>Ahorro vs. tarifa normal</span></div>
    </div>
  </div>
  {% for f in p.extras %}
  <div class="tab-panel" id="cond-panel-extra{{ loop.index }}">
    <div class="stats">
      <div class="stat"><b data-fmt="eur2" data-value="{{ f.precio }}">{{ f.precio|eur(2) }}</b><span>€/emp/mes</span></div>
      <div class="stat"><b data-fmt="eur2" data-value="{{ f.mensual }}">{{ f.mensual|eur(2) }}</b><span>Total mensual</span></div>
      <div class="stat"><b data-fmt="eur0" data-value="{{ f.anio1 }}">{{ f.anio1|eur }}</b><span>Total año 1</span></div>
      <div class="stat hi"><b data-fmt="pct" data-value="{{ f.ahorro_pct }}">-{{ f.ahorro_pct }} %</b><span>Ahorro vs. tarifa normal</span></div>
    </div>
  </div>
  {% endfor %}
</div>

<details class="detail">
  <summary>Ver el desglose completo</summary>
  <div class="table-scroll"><table>
    <tr><th>Concepto</th><th class="num">Precio normal</th><th class="num">Precio final</th></tr>
    <tr><td>Integración (pago único)</td><td class="num">{{ p.integracion|eur }}</td><td class="num">{{ p.integracion|eur }}</td></tr>
    <tr><td>Precio/emp/mes</td><td class="num">{{ p.normal.precio|eur }}</td><td class="num"><b>{{ p.oferta.precio|eur(2) }}</b></td></tr>
    <tr><td>Total mensual</td><td class="num">{{ p.normal.mensual|eur }}</td><td class="num">{{ p.oferta.mensual|eur(2) }}</td></tr>
    <tr><td>Total año 1</td><td class="num">{{ p.normal.anio1|eur }}</td><td class="num"><b>{{ p.oferta.anio1|eur }}</b></td></tr>
    <tr><td>Ahorro frente a la tarifa normal</td><td class="num">—</td><td class="num">-{{ p.oferta.ahorro|eur }} (-{{ p.oferta.ahorro_pct }} %)</td></tr>
    {% for f in p.extras %}
    <tr{% if loop.last %} class="hi"{% endif %}><td>{{ f.nombre }}</td><td class="num">—</td><td class="num">{{ f.precio|eur(2) }}/emp/mes · {{ f.anio1|eur }} año 1 (-{{ f.ahorro_pct }} %)</td></tr>
    {% endfor %}
  </table></div>
</details>
{% endmacro %}
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Propuesta de colaboración · {{ c.nombre }}</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --indigo:#4F46E5; --indigo-2:#4338CA; --violet:#7C3AED; --navy:#221F5E; --ink-bg:#0B0A1A;
  --ink:#161328; --muted:#6B6B85; --line:rgba(22,19,40,.12); --soft:#F4F4FF; --bg:#FFFFFF;
}
*{box-sizing:border-box} html,body{height:100%}
body{margin:0;font-family:Inter,system-ui,sans-serif;color:var(--ink);background:#000;font-size:18px;line-height:1.55;-webkit-font-smoothing:antialiased}
h1,h2,h3,.display{font-family:"Plus Jakarta Sans",Inter,sans-serif;letter-spacing:-.02em;line-height:1.08;margin:0}
a{color:inherit}
button{font:inherit;background:none;border:0}

/* ===== El "deck": una diapositiva por pantalla, con scroll-snap nativo ===== */
.deck{height:100dvh;height:100vh;overflow-y:scroll;scroll-snap-type:y mandatory;scroll-behavior:smooth;
  -webkit-overflow-scrolling:touch}
.slide{min-height:100dvh;min-height:100vh;scroll-snap-align:start;scroll-snap-stop:always;
  display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden;
  padding:calc(76px + 2vh) 8vw 76px}
.slide::before{content:"";position:absolute;inset:0;z-index:0;opacity:.5;
  background-image:radial-gradient(circle,rgba(127,127,255,.18) 1px,transparent 1.4px);background-size:26px 26px}
.content{position:relative;z-index:1;max-width:980px;width:100%;margin:0 auto;max-height:calc(100vh - 76px - 76px - 2vh);
  overflow-y:auto;padding-right:8px;opacity:0;transform:translateY(26px);transition:opacity .6s ease,transform .6s ease}
.slide.active .content{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.content{transition:none;opacity:1;transform:none}}
noscript .content, html.no-js .content{opacity:1;transform:none}

/* Temas de color por diapositiva, con "aurora" animada de fondo */
.theme-light{background:var(--bg);color:var(--ink)}
.theme-light::before{opacity:.35}
.theme-tint{background:var(--soft);color:var(--ink)}
.theme-indigo{background:var(--indigo);color:#fff}
.theme-navy{background:var(--navy);color:#fff}
.theme-dark{background:var(--ink-bg);color:#fff}
.slide::after{content:"";position:absolute;inset:-10%;z-index:0;pointer-events:none;opacity:0;
  background:radial-gradient(circle at 18% 22%,#8B87FF 0%,transparent 45%),radial-gradient(circle at 85% 78%,#FF6FD8 0%,transparent 40%),radial-gradient(circle at 60% 10%,#38E1D0 0%,transparent 35%);
  filter:blur(60px) saturate(1.3);animation:auroraDrift 22s ease-in-out infinite alternate}
.theme-indigo::after,.theme-navy::after,.theme-dark::after{opacity:.55}
.theme-indigo::after{background:radial-gradient(circle at 15% 20%,#A5A2FF 0%,transparent 45%),radial-gradient(circle at 88% 82%,#5B4FE8 0%,transparent 50%),radial-gradient(circle at 55% 95%,#38E1D0 0%,transparent 38%)}
.theme-navy::after{background:radial-gradient(circle at 85% 12%,#7A6EF0 0%,transparent 45%),radial-gradient(circle at 8% 92%,#2A2470 0%,transparent 50%),radial-gradient(circle at 50% 50%,#FF6FD8 0%,transparent 30%)}
.theme-dark::after{background:radial-gradient(circle at 50% 0%,#4A3FCF 0%,transparent 55%),radial-gradient(circle at 90% 90%,#38E1D0 0%,transparent 30%)}
@keyframes auroraDrift{0%{transform:translate(0,0) rotate(0deg) scale(1)}50%{transform:translate(-3%,2%) rotate(6deg) scale(1.08)}100%{transform:translate(2%,-3%) rotate(-4deg) scale(1.04)}}
.theme-indigo::before,.theme-navy::before,.theme-dark::before{opacity:.14;background-image:radial-gradient(circle,rgba(255,255,255,.5) 1px,transparent 1.4px)}
@media (prefers-reduced-motion:reduce){.slide::after{animation:none}}

/* Grano de película sutil, fijo sobre toda la página */
.grain{position:fixed;inset:0;z-index:65;pointer-events:none;opacity:.05;mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>")}

/* Foco de luz que sigue al cursor (solo escritorio, con puntero preciso) */
#spotlight{position:fixed;top:0;left:0;width:520px;height:520px;margin:-260px 0 0 -260px;border-radius:50%;
  background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%);mix-blend-mode:screen;z-index:2;
  pointer-events:none;opacity:0;transition:opacity .3s}
#spotlight.on{opacity:1}

.kicker{display:flex;align-items:center;gap:12px;margin-bottom:26px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:13px;opacity:.8}
.kicker .idx{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:9px;background:currentColor;color:transparent;position:relative;font-size:0}
.kicker .idx::after{content:attr(data-n)}
.theme-light .kicker .idx,.theme-tint .kicker .idx{background:var(--indigo)}
.kicker .idx{background:var(--indigo);color:#fff!important;font-size:13px}
.theme-indigo .kicker .idx,.theme-navy .kicker .idx,.theme-dark .kicker .idx{background:rgba(255,255,255,.18)}

h1.big,h2.big{font-size:clamp(34px,5vw,58px);font-weight:800}
h1.big em{font-style:normal;background:linear-gradient(100deg,#8B87FF,#38E1D0 45%,#FF6FD8,#8B87FF);
  background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;
  animation:shine 8s ease-in-out infinite}
@keyframes shine{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
@media (prefers-reduced-motion:reduce){h1.big em{animation:none}}
.theme-indigo h2.big,.theme-navy h2.big,.theme-dark h1.big{color:#fff}
.theme-light h2.big,.theme-tint h2.big{color:var(--indigo)}
.lead{font-size:clamp(19px,2vw,24px);line-height:1.5;margin:22px 0 0;max-width:52ch}
.eyebrow-txt{opacity:.85}
.quote-xl{font-family:"Plus Jakarta Sans";font-weight:700;font-size:clamp(24px,3.4vw,40px);line-height:1.3;margin:0}
.h3{font-size:22px;font-weight:700;margin:0 0 4px}
p.small{font-size:15px;color:var(--muted)}
.theme-indigo p.small,.theme-navy p.small,.theme-dark p.small{color:rgba(255,255,255,.75)}

.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:8px}
.card{--rx:0deg;--ry:0deg;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:20px;padding:26px;
  transition:transform .15s ease,box-shadow .3s;transform:perspective(700px) rotateX(var(--rx)) rotateY(var(--ry));
  transform-style:preserve-3d;will-change:transform}
.theme-light .card,.theme-tint .card{background:#fff;border-color:var(--line);box-shadow:0 10px 30px rgba(34,31,94,.06)}
.card:hover{box-shadow:0 20px 45px rgba(0,0,0,.22)}
@media (prefers-reduced-motion:reduce),(pointer:coarse){.card{transform:none!important}}
.card h3{font-size:21px;margin-bottom:6px}
.card .frase{font-weight:600;opacity:.9;margin-bottom:10px}
.card ul{padding-left:20px;margin:10px 0 0;font-size:15.5px}
.card ul li+li{margin-top:4px}
.pain-num{font-family:"Plus Jakarta Sans";font-size:44px;font-weight:800;opacity:.35;line-height:1;margin-bottom:6px}

.flow{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:12px;counter-reset:f}
.flow div{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:20px}
.flow div::before{counter-increment:f;content:counter(f);display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#fff;color:var(--navy);font-weight:800;font-size:14px;margin-bottom:12px}
.flow b{display:block;font-family:"Plus Jakarta Sans";font-size:18px}
.flow span{font-size:14.5px;opacity:.85}

.cover-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:40px;align-items:center}
.cover-grid img{width:100%;max-width:300px;justify-self:center;filter:drop-shadow(0 20px 40px rgba(0,0,0,.35))}
.meta-line{font-size:16.5px;margin:6px 0;opacity:.9}

/* Pestañas CSS-only (personajes / piloto-implementación / condición) */
.tabgroup{display:flex;flex-wrap:wrap;gap:10px}
.tab-radio{position:absolute;opacity:0;width:1px;height:1px}
.tab-btn,.cast-card{cursor:pointer;user-select:none;border:1.5px solid rgba(255,255,255,.25);border-radius:14px;
  padding:10px 18px;font-weight:600;font-size:15px;transition:.15s;background:rgba(255,255,255,.05);color:inherit}
.tab-btn.sm{padding:8px 16px;font-size:14px;border-color:var(--line);background:#fff;color:var(--ink)}
.theme-indigo .tab-btn.sm,.theme-navy .tab-btn.sm,.theme-dark .tab-btn.sm{border-color:rgba(255,255,255,.25);background:rgba(255,255,255,.06);color:#fff}
.tab-radio:checked+.tab-btn{background:#fff;color:var(--navy);border-color:#fff}
.tab-radio:checked+.tab-btn.sm{background:var(--indigo);color:#fff;border-color:var(--indigo)}
.tab-radio:focus-visible+label{outline:2px solid #fff;outline-offset:3px}
.tab-panel{display:none;flex-basis:100%;margin-top:18px}
.hint-click{font-size:14px;opacity:.75;margin:2px 0 16px}

.cast-card{flex:1 1 160px;text-align:center;padding:18px 14px}
.cast-card small{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.06em;opacity:.7;margin-bottom:4px}
.cast-card b{font-size:18px;font-family:"Plus Jakarta Sans"}
.tab-radio:checked+.cast-card{background:#fff;color:var(--navy)}
.cast-card .thumb{width:52px;height:52px;border-radius:50%;object-fit:cover;margin:0 auto 10px;display:block;
  border:2px solid rgba(255,255,255,.4)}
.tab-radio:checked+.cast-card .thumb{border-color:var(--indigo)}

.persona{display:grid;grid-template-columns:1fr 1.5fr;gap:28px;align-items:center;margin-top:22px}
.persona .who{text-align:center}
.persona .who .av{width:96px;height:96px;border-radius:50%;background:rgba(255,255,255,.1);display:grid;place-items:center;
  margin:0 auto 10px;font-family:"Plus Jakarta Sans";font-size:32px;font-weight:800;overflow:hidden}
.persona .who .av img{width:100%;height:100%;object-fit:cover}
.video{position:relative;padding-top:62.5%;border-radius:16px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,.4)}
.video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
ul.check{padding-left:22px;margin:14px 0 0}
ul.check li+li{margin-top:6px}

.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}
.stat{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:18px}
.theme-light .stat,.theme-tint .stat{background:var(--soft);border-color:var(--line)}
.stat b{display:block;font-family:"Plus Jakarta Sans";font-size:clamp(20px,2.2vw,27px)}
.stat span{font-size:13.5px;opacity:.8}
.stat.hi{background:rgba(255,255,255,.16)}
.theme-light .stat.hi,.theme-tint .stat.hi{background:#EEF2FF;border-color:var(--indigo)}
.card-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:20px}
.card-grid>div{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:18px}
.card-grid b{display:block;font-family:"Plus Jakarta Sans";font-size:17px;margin-bottom:3px}
.card-grid span{font-size:13.5px;opacity:.8}
.tag{display:inline-block;background:rgba(255,255,255,.18);border-radius:999px;padding:3px 12px;font-size:13px;font-weight:600;margin-left:8px;vertical-align:middle}

details.detail{margin-top:18px}
details.detail summary{cursor:pointer;font-weight:600;font-size:15px;opacity:.9;list-style:none}
details.detail summary::-webkit-details-marker{display:none}
details.detail summary::before{content:"▸ ";display:inline-block;transition:transform .15s}
details.detail[open] summary::before{transform:rotate(90deg)}
table{width:100%;border-collapse:collapse;margin:14px 0 4px;font-size:14.5px}
th,td{border:1px solid rgba(255,255,255,.16);padding:10px 12px;text-align:left;vertical-align:top}
th{background:rgba(255,255,255,.08);font-weight:600}
.theme-light th,.theme-tint th{background:var(--soft);border-color:var(--line)}
.theme-light td,.theme-tint td{border-color:var(--line)}
td.num,th.num{text-align:right;white-space:nowrap}
tr.hi td{background:rgba(255,255,255,.1);font-weight:700}
.theme-light tr.hi td,.theme-tint tr.hi td{background:#EEF2FF}

.callout{background:rgba(255,255,255,.08);border-radius:18px;padding:22px 26px;margin-top:26px}
.theme-light .callout,.theme-tint .callout{background:var(--soft)}
.cta{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--indigo)!important;text-decoration:none;
  font-weight:700;border-radius:999px;padding:13px 24px;margin-top:16px;transition:.15s}
.cta:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,.25)}
.theme-light .cta,.theme-tint .cta{background:var(--indigo);color:#fff!important}

.steps{counter-reset:s;list-style:none;padding:0;margin-top:8px;display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.steps li{background:rgba(255,255,255,.08);border-radius:14px;padding:14px 16px 14px 52px;position:relative;font-size:15.5px}
.steps li::before{counter-increment:s;content:counter(s);position:absolute;left:16px;top:13px;width:26px;height:26px;border-radius:50%;
  background:#fff;color:var(--navy);display:grid;place-items:center;font-weight:800;font-size:13px}

.pills{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.pills span{border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:9px 18px;font-weight:600;font-size:14.5px}

.team{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:8px}
.team .card h3{font-size:22px}
.team p{margin:4px 0;font-size:15.5px}
.conf{font-size:12.5px;opacity:.55;max-width:640px;margin-top:34px}

.scroll-hint{position:absolute;left:50%;bottom:100px;transform:translateX(-50%);z-index:1;display:flex;
  flex-direction:column;align-items:center;gap:6px;font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;
  opacity:.7;animation:hintBounce 2.2s ease-in-out infinite}
.scroll-hint svg{width:18px;height:18px}
@keyframes hintBounce{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,8px)}}
@media (prefers-reduced-motion:reduce){.scroll-hint{animation:none}}

/* ===== Cromo fijo: progreso, menú, contador, flechas, CTA ===== */
#progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,#fff,#C7C4FF);z-index:80;transition:width .2s ease}
.chrome-btn{position:fixed;z-index:70;display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.85);
  color:var(--ink)!important;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:999px;
  padding:10px 16px;font-weight:600;font-size:14px;text-decoration:none;box-shadow:0 6px 20px rgba(0,0,0,.15);border:1px solid rgba(255,255,255,.6)}
#menuBtn{top:18px;left:18px}
#talkBtn{top:18px;right:18px}
.chev{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);z-index:70;display:flex;align-items:center;gap:14px;
  background:rgba(20,18,40,.55);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:999px;padding:8px 10px;color:#fff}
.chev-btn{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.14);
  text-decoration:none;color:#fff!important;font-size:20px;transition:.15s}
.chev-btn:hover{background:rgba(255,255,255,.28)}
.chev-btn.ghost{opacity:.3;pointer-events:none}
.counter{font-size:13px;font-variant-numeric:tabular-nums;opacity:.9;min-width:64px;text-align:center}

/* Índice de diapositivas (menú overlay, 100% CSS con checkbox) */
#menuToggle{position:absolute;opacity:0;pointer-events:none}
.menu-overlay{position:fixed;inset:0;z-index:90;background:rgba(11,10,26,.94);display:none;flex-direction:column;
  align-items:center;justify-content:center;gap:6px;padding:24px}
#menuToggle:checked~.menu-overlay{display:flex}
.menu-overlay a{color:#fff;text-decoration:none;font-family:"Plus Jakarta Sans";font-size:clamp(20px,3.4vw,30px);
  font-weight:700;padding:8px 18px;border-radius:12px;opacity:.75;transition:.15s}
.menu-overlay a:hover{opacity:1;background:rgba(255,255,255,.08)}
.menu-overlay a span{color:#8B87FF;font-weight:800;margin-right:14px;font-size:.7em}
label.close-menu{position:absolute;top:18px;right:18px;color:#fff;font-size:28px;cursor:pointer;width:44px;height:44px;
  display:grid;place-items:center;border-radius:50%}
label.close-menu:hover{background:rgba(255,255,255,.1)}

@media (max-width:900px){
  .slide{padding:calc(64px + 2vh) 6vw 88px}
  .cover-grid,.grid3,.flow,.persona,.stats,.card-grid,.steps,.team{grid-template-columns:1fr}
  .table-scroll{overflow-x:auto}
  #talkBtn span.txt{display:none}
}
@media print{
  html{background:#fff}
  #progress,.chrome-btn,.chev,.menu-overlay,#menuToggle,.grain,#spotlight,.scroll-hint{display:none!important}
  .deck{height:auto;overflow:visible;scroll-snap-type:none}
  .slide{min-height:0;height:auto;page-break-inside:avoid;padding:36px 40px;display:block}
  .content{max-height:none;overflow:visible;opacity:1!important;transform:none!important;transition:none!important}
  .slide::before,.slide::after{display:none}
  .card{transform:none!important}
  h1.big em{animation:none;-webkit-text-fill-color:var(--indigo);background:none;color:var(--indigo)}
  .video{display:none}
  details.detail{display:block!important}
  details.detail>*{display:block!important}
  .theme-indigo,.theme-navy,.theme-dark,.theme-light,.theme-tint{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
{# Reglas de mostrar/ocultar por cada grupo de pestañas: 100% CSS, funciona sin JavaScript #}
<style>
{% for b in d.demo.bloques %}#tab-{{ b.clave }}:checked~#panel-{{ b.clave }}{display:block}
{% endfor %}
#modo-piloto:checked~#panel-piloto{display:block}
#modo-full:checked~#panel-full{display:block}
#cond-base:checked~#cond-panel-base{display:block}
{% for f in p.extras %}#cond-extra{{ loop.index }}:checked~#cond-panel-extra{{ loop.index }}{display:block}
{% endfor %}
</style>
</head>
<body>
<div class="grain"></div>
<div id="spotlight"></div>
<div id="progress"></div>
<input type="checkbox" id="menuToggle">
<button id="menuBtn" class="chrome-btn" aria-label="Índice de diapositivas">
  <label for="menuToggle" style="cursor:pointer">☰ Índice</label>
</button>
<a id="talkBtn" class="chrome-btn" href="mailto:{{ d.autor.email }}?subject={{ ('Hablemos de la propuesta — ' ~ c.nombre) | urlencode }}">💬 <span class="txt">Hablar con {{ d.autor.nombre.split(' ')[0] }}</span></a>

<div class="menu-overlay">
  <label class="close-menu" for="menuToggle">×</label>
  <a href="#cover"><span>01</span>Portada</a>
  <a href="#objetivo"><span>02</span>El objetivo</a>
  <a href="#oportunidad"><span>03</span>La oportunidad</a>
  <a href="#dolores"><span>04</span>Lo que os está costando</a>
  <a href="#solucion"><span>05</span>La solución</a>
  <a href="#accion"><span>06</span>Del insight a la acción</a>
  <a href="#demo"><span>07</span>La demo</a>
  <a href="#precio"><span>08</span>Propuesta económica</a>
  <a href="#pasos"><span>09</span>Próximos pasos</a>
  <a href="#seguridad"><span>10</span>Seguridad</a>
  <a href="#integraciones"><span>11</span>Integraciones</a>
  <a href="#clientes"><span>12</span>Clientes</a>
  <a href="#contacto"><span>13</span>Contacto</a>
</div>

<main class="deck" id="deck">

<section class="slide theme-dark" id="cover">
  <div class="content cover-grid">
    <div>
      {{ kicker('Propuesta de colaboración') }}
      <h1 class="big">{{ d.portada.titular|safe }}</h1>
      <p class="lead">"{{ d.portada.subtitulo }}"</p>
      <p class="meta-line">{{ d.portada.linea_integraciones }}</p>
      <p class="meta-line">Preparado para <b>{{ c.contacto.nombre }}</b> · {{ c.nombre }} · {{ d.fecha }}</p>
    </div>
    {% if d.portada.imagen %}<img src="{{ d.portada.imagen }}" alt="KAI, el asistente de Kincode">{% endif %}
  </div>
  <div class="scroll-hint" aria-hidden="true">Desliza
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 4v16M6 14l6 6 6-6"/></svg>
  </div>
  {{ chevrons(none, 'objetivo') }}
</section>

<section class="slide theme-indigo" id="objetivo">
  <div class="content">
    {{ kicker('Tenemos claro el objetivo') }}
    <h2 class="big">{{ d.objetivo.titular }}</h2>
    <p class="quote-xl" style="margin-top:28px">"{{ d.objetivo.cita }}"</p>
  </div>
  {{ chevrons('cover', 'oportunidad') }}
</section>

<section class="slide theme-light" id="oportunidad">
  <div class="content">
    {{ kicker('La oportunidad') }}
    <h2 class="big">"{{ d.oportunidad.titular }}"</h2>
    <p class="lead" style="max-width:64ch"><b>Tu realidad:</b> {{ d.oportunidad.realidad }}</p>
    <p class="lead" style="font-size:18px;max-width:64ch;margin-top:14px"><b>Tu desafío:</b> {{ d.oportunidad.desafio }}</p>
  </div>
  {{ chevrons('objetivo', 'dolores') }}
</section>

<section class="slide theme-navy" id="dolores">
  <div class="content">
    {{ kicker('Lo que os está costando hoy') }}
    <h2 class="big" style="font-size:clamp(28px,3.6vw,40px)">Qué está pasando. Dónde. Y por qué.</h2>
    <div class="grid3" style="margin-top:32px">
      {% for x in d.oportunidad.pains %}
      <div class="card"><div class="pain-num">0{{ loop.index }}</div><h3>{{ x.titulo }}</h3><div class="frase">{{ x.frase }}</div><p style="font-size:15px;opacity:.85">{{ x.detalle }}</p></div>
      {% endfor %}
    </div>
    <p class="quote-xl" style="margin-top:34px;font-size:clamp(19px,2.2vw,26px)">{{ d.oportunidad.insight }}</p>
  </div>
  {{ chevrons('oportunidad', 'solucion') }}
</section>

<section class="slide theme-light" id="solucion">
  <div class="content">
    {{ kicker('La solución') }}
    <h2 class="big">Esto es cómo no vais a ciegas</h2>
    <p class="lead">Qué está pasando hoy. Dónde. Y por qué.</p>
    <div class="grid3">
      {% for x in d.solucion.pilares %}
      <div class="card"><h3>{{ x.titulo }}</h3><div class="frase">"{{ x.frase }}"</div>
        <ul>{% for i in x.puntos %}<li>{{ i }}</li>{% endfor %}</ul></div>
      {% endfor %}
    </div>
  </div>
  {{ chevrons('dolores', 'accion') }}
</section>

<section class="slide theme-indigo" id="accion">
  <div class="content">
    {{ kicker('De la señal a la acción') }}
    <h2 class="big" style="font-size:clamp(28px,3.6vw,42px)">Del insight a la acción</h2>
    <p class="lead">Cada señal cultural dispara una acción concreta a través de Kincode AI</p>
    <div class="flow">
      {% for x in d.del_insight_a_la_accion %}<div><b>{{ x.paso }}</b><span>{{ x.texto }}</span></div>{% endfor %}
    </div>
    <p class="quote-xl" style="margin-top:32px;font-size:clamp(19px,2.2vw,25px)">"{{ d.solucion.cita }}"</p>
  </div>
  {{ chevrons('solucion', 'demo') }}
</section>

<section class="slide theme-navy" id="demo">
  <div class="content">
    {{ kicker('La demo, en resumen') }}
    <h2 class="big" style="font-size:clamp(28px,3.6vw,40px)">Personajes de la demo</h2>
    <p class="hint-click">Toca un personaje para ver su parte de la demo ↓</p>

    <div class="tabgroup" style="margin-top:6px">
      {% for b in d.demo.bloques %}
      <input type="radio" name="persona" id="tab-{{ b.clave }}" class="tab-radio" {% if loop.first %}checked{% endif %}>
      {% set per = d.demo.personajes[b.clave] %}
      <label for="tab-{{ b.clave }}" class="cast-card">
        {% if per.foto %}<img class="thumb" src="{{ per.foto }}" alt="{{ per.nombre }}">{% endif %}
        <small>{{ b.rol }}</small><b>{{ per.nombre }}</b>
      </label>
      {% endfor %}

      {% for b in d.demo.bloques %}
      <div class="tab-panel" id="panel-{{ b.clave }}">
        <p class="small" style="text-transform:uppercase;letter-spacing:.06em;font-weight:700;margin:0 0 6px">{{ b.etiqueta }}</p>
        <h3 class="h3" style="font-size:24px">{{ b.titular }}</h3>
        <ul class="check">{% for i in b.puntos %}<li>{{ i }}</li>{% endfor %}</ul>
        <div class="persona">
          {% set per = d.demo.personajes[b.clave] %}
          <div class="who">
            <div class="av">{% if per.foto %}<img src="{{ per.foto }}" alt="{{ per.nombre }}">{% else %}{{ per.nombre[:1] }}{% endif %}</div>
            <span class="small" style="opacity:1">{{ b.rol }}</span><br><small>{{ per.nombre }}</small>
          </div>
          {% if b.video %}<div><div class="video"><iframe src="{{ b.video }}" title="Demo: {{ b.titular }}" loading="lazy" allowfullscreen></iframe></div>
          <p style="font-size:14px;margin-top:8px"><a href="{{ b.video|replace('/embed/','/share/') }}" target="_blank" rel="noopener">▶ Ver el vídeo en Loom</a></p></div>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {{ chevrons('accion', 'precio') }}
</section>

<section class="slide theme-light" id="precio">
  <div class="content">
    {{ kicker('Propuesta económica') }}
    <h2 class="big">{{ c.nombre }}</h2>
    <p class="lead" style="font-size:18px;margin-top:4px"><b>{{ p.n }} empleados</b> · {{ c.pais }} · {{ c.stack }}</p>

    {% if p.mostrar_piloto %}
    <div class="tabgroup" style="margin-top:22px">
      <input type="radio" name="modo" id="modo-piloto" class="tab-radio" checked>
      <label for="modo-piloto" class="tab-btn sm">Opción 1 · Piloto</label>
      <input type="radio" name="modo" id="modo-full" class="tab-radio">
      <label for="modo-full" class="tab-btn sm">Opción 2 · Implementación completa</label>

      <div class="tab-panel" id="panel-piloto">
        <div class="card-grid">
          <div><b>{{ p.piloto.personas }}</b><span>Alcance (~{{ p.piloto.pct }} % de la empresa)</span></div>
          <div><b>{{ p.piloto.duracion }}</b><span>Duración</span></div>
          <div><b>{{ p.piloto.coste }}</b><span>Coste</span></div>
          <div><b>{{ p.piloto.si_no }}</b><span>Si no se firma el anual</span></div>
        </div>
        <a class="cta" href="mailto:{{ d.autor.email }}?subject={{ ('Quiero empezar por el piloto — ' ~ c.nombre) | urlencode }}">Empezar por el piloto →</a>
      </div>

      <div class="tab-panel" id="panel-full">{{ implementacion() }}</div>
    </div>
    {% else %}
    {{ implementacion() }}
    {% endif %}

    <div class="callout">
      <b>Ruta sugerida</b>
      <p style="margin:6px 0">{{ p.ruta }}</p>
      <p style="margin:0">Con la mejor condición: <b>{{ p.mejor.precio|eur(2) }}/emp/mes</b> — menos de un café por persona al mes.</p>
      <a class="cta" href="mailto:{{ d.autor.email }}?subject={{ ('Adelante con la propuesta — ' ~ c.nombre) | urlencode }}">Reservar mi plan →</a>
    </div>
  </div>
  {{ chevrons('demo', 'pasos') }}
</section>

<section class="slide theme-navy" id="pasos">
  <div class="content">
    {{ kicker('Próximos pasos') }}
    <h2 class="big" style="font-size:clamp(28px,3.6vw,40px)">{{ d.proximos_pasos.titular }}</h2>
    <ol class="steps">{% for s in d.proximos_pasos.pasos %}<li>{{ s }}</li>{% endfor %}</ol>
    <a class="cta" href="mailto:{{ d.autor.email }}?subject={{ ('Siguiente paso — ' ~ c.nombre) | urlencode }}">Agendar el siguiente paso →</a>
  </div>
  {{ chevrons('precio', 'seguridad') }}
</section>

<section class="slide theme-light" id="seguridad">
  <div class="content">
    {{ kicker('Cumplimiento y seguridad') }}
    <h2 class="big" style="font-size:clamp(28px,3.6vw,40px)">{{ d.seguridad.titular }}</h2>
    <ul class="check">{% for i in d.seguridad.puntos %}<li>{{ i }}</li>{% endfor %}</ul>
    <div class="table-scroll"><table>
      <tr><th>Stack tecnológico</th><th>Documentación</th></tr>
      {% for s in d.seguridad.stack %}<tr><td>{{ s.nombre }}</td><td><a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.url }}</a></td></tr>{% endfor %}
    </table></div>
  </div>
  {{ chevrons('pasos', 'integraciones') }}
</section>

<section class="slide theme-indigo" id="integraciones">
  <div class="content">
    {{ kicker('Integraciones') }}
    <h2 class="big" style="font-size:clamp(28px,3.6vw,42px)">{{ d.integraciones.titular }}</h2>
    <p class="lead">{{ d.integraciones.texto }}</p>
  </div>
  {{ chevrons('seguridad', 'clientes') }}
</section>

<section class="slide theme-dark" id="clientes">
  <div class="content">
    {{ kicker('No estás solo en la transformación') }}
    <h2 class="big" style="font-size:clamp(28px,3.6vw,46px)">Ya confían en Kincode</h2>
    <div class="pills">{% for l in d.clientes_logos %}<span>{{ l }}</span>{% endfor %}</div>
  </div>
  {{ chevrons('integraciones', 'contacto') }}
</section>

<section class="slide theme-navy" id="contacto">
  <div class="content">
    {{ kicker('Hablemos') }}
    <h2 class="big" style="font-size:clamp(28px,3.6vw,40px)">Contacto</h2>
    <div class="team">
      {% for m in d.equipo %}
      <div class="card"><h3>{{ m.nombre }}</h3>
        <p>📞 {{ m.telefono }}</p>
        <p>📧 <a href="mailto:{{ m.email }}">{{ m.email }}</a></p>
        <p>LinkedIn: <a href="https://www.linkedin.com/in/{{ m.linkedin }}" target="_blank" rel="noopener">@{{ m.linkedin }}</a></p></div>
      {% endfor %}
    </div>
    <p class="conf">{{ d.confidencial }} · © {{ d.fecha[-4:] }} Kincode</p>
  </div>
  {{ chevrons('clientes', none) }}
</section>

</main>

<script>
const deck=document.getElementById('deck');
const slides=[...document.querySelectorAll('.slide')];
const bar=document.getElementById('progress');
const counters=[...document.querySelectorAll('[data-counter]')];
const total=slides.length;

function setActive(i){
  slides.forEach((s,idx)=>s.classList.toggle('active',idx===i));
  bar.style.width=((i+1)/total*100)+'%';
  const label=String(i+1).padStart(2,'0')+' / '+String(total).padStart(2,'0');
  counters.forEach(c=>c.textContent=label);
}

if('IntersectionObserver' in window){
  const io=new IntersectionObserver(es=>{
    es.forEach(e=>{ if(e.isIntersecting){ setActive(slides.indexOf(e.target)); } });
  },{root:deck,threshold:.55});
  slides.forEach(s=>io.observe(s));
}else{
  slides.forEach(s=>s.classList.add('active'));
  setActive(0);
}

// Navegación por teclado (además del scroll, el swipe y los enlaces ‹ › que ya funcionan sin JS)
addEventListener('keydown',e=>{
  if(document.getElementById('menuToggle').checked) return;
  const cur=slides.findIndex(s=>s.classList.contains('active'));
  if(['ArrowDown','ArrowRight','PageDown',' '].includes(e.key)){e.preventDefault();const t=slides[Math.min(cur+1,total-1)];t&&t.scrollIntoView({behavior:'smooth'});}
  if(['ArrowUp','ArrowLeft','PageUp'].includes(e.key)){e.preventDefault();const t=slides[Math.max(cur-1,0)];t&&t.scrollIntoView({behavior:'smooth'});}
});

// El menú-índice cierra al elegir una diapositiva
document.querySelectorAll('.menu-overlay a').forEach(a=>a.addEventListener('click',()=>{document.getElementById('menuToggle').checked=false;}));

const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
const fine=matchMedia('(pointer: fine)').matches;

// Foco de luz que sigue al cursor (con inercia suave)
if(!reduced && fine){
  const sp=document.getElementById('spotlight');
  let tx=innerWidth/2, ty=innerHeight/2, cx=tx, cy=ty;
  addEventListener('mousemove',e=>{tx=e.clientX;ty=e.clientY;sp.classList.add('on');});
  addEventListener('mouseleave',()=>sp.classList.remove('on'));
  (function loop(){cx+=(tx-cx)*.12;cy+=(ty-cy)*.12;sp.style.transform=`translate(${cx}px,${cy}px)`;requestAnimationFrame(loop);})();
}

// Inclinación 3D sutil de las tarjetas al pasar el cursor
if(!reduced && fine){
  document.querySelectorAll('.card').forEach(card=>{
    card.addEventListener('pointermove',e=>{
      const r=card.getBoundingClientRect();
      const px=(e.clientX-r.left)/r.width-.5, py=(e.clientY-r.top)/r.height-.5;
      card.style.setProperty('--ry',(px*8)+'deg');
      card.style.setProperty('--rx',(-py*8)+'deg');
    });
    card.addEventListener('pointerleave',()=>{card.style.setProperty('--rx','0deg');card.style.setProperty('--ry','0deg');});
  });
}

// Cifras de precio que cuentan hacia arriba al cambiar de pestaña.
// Formato manual en vez de toLocaleString: no todos los navegadores traen los
// datos de la locale es-ES completos, y así el resultado siempre coincide con
// el filtro `eur()` de Python (punto de miles, coma decimal).
function esNumber(v,decimales){
  const s=v.toFixed(decimales);
  const [ent,dec]=s.split('.');
  const conMiles=ent.replace(/\B(?=(\d{3})+(?!\d))/g,'.');
  return dec!==undefined ? conMiles+','+dec : conMiles;
}
function formatStat(type,v){
  if(type==='eur2') return esNumber(v,2)+' €';
  if(type==='eur0') return esNumber(Math.round(v),0)+' €';
  if(type==='pct') return '-'+Math.round(v)+' %';
  return String(v);
}
function animateStat(el){
  const type=el.dataset.fmt, target=parseFloat(el.dataset.value);
  if(!type||isNaN(target)) return;
  if(reduced){el.textContent=formatStat(type,target);return;}
  const start=performance.now(), dur=600;
  (function tick(now){
    const t=Math.min(1,(now-start)/dur), eased=1-Math.pow(1-t,3);
    el.textContent=formatStat(type,target*eased);
    if(t<1) requestAnimationFrame(tick);
  })(performance.now());
}
function animateVisiblePanels(group){
  group.querySelectorAll('.tab-panel').forEach(panel=>{
    if(getComputedStyle(panel).display!=='none'){
      panel.querySelectorAll('[data-fmt]').forEach(animateStat);
    }
  });
}
document.querySelectorAll('input.tab-radio').forEach(r=>r.addEventListener('change',()=>{
  const grp=r.closest('.tabgroup'); if(grp) animateVisiblePanels(grp);
}));
document.querySelectorAll('.tabgroup').forEach(animateVisiblePanels);
</script>
</body>
</html>
